API_KEY=your_api_key_here
# Base API tracking sesuai kontrak FRD.
VITE_API_URL=http://localhost:8000/api/v1
# Opsional: endpoint latihan PHP lama pada port terpisah.
VITE_PHP_API_URL=http://localhost:8000

# Google Gemini API Key untuk live client di frontend
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash-lite